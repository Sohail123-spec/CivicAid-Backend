# Backend environment variable template
# Copy this file to .env, supply real values, and never commit .env to version control.
#
# The backend reads these variables at startup via application.properties
# using the ${VARIABLE_NAME} placeholder syntax.

# ─── Database ────────────────────────────────────────────────────────────────

# Full JDBC URL for the PostgreSQL database.
# Example: jdbc:postgresql://localhost:5432/civicaid
DB_URL=jdbc:postgresql://localhost:5432/civicaid

# PostgreSQL username granted access to the civicaid database.
DB_USERNAME=civicaid_user

# PostgreSQL password. Use a strong, unique value.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────

# HS256 signing secret. Must be at minimum 32 characters long.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET_VALUE_HERE

# Token validity duration in milliseconds (default: 86400000 = 24 hours).
# JWT_EXPIRATION_MS=86400000

# ─── CORS (optional) ─────────────────────────────────────────────────────────

# Comma-separated list of allowed origins in addition to localhost defaults.
# Leave unset for local development; Vite dev proxy handles CORS transparently.
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com
